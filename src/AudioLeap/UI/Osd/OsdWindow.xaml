<Window x:Class="AudioLeap.UI.Osd.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Margen exterior: espacio para la sombra suave -->
    <Border x:Name="RootBorder"
            Margin="24"
            MinWidth="300"
            CornerRadius="14"
            Background="{DynamicResource OsdBackgroundBrush}"
            RenderTransformOrigin="0.5,0.5">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="SlideTransform"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                              Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16,13,18,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icono del dispositivo (Segoe Fluent Icons) -->
            <TextBlock x:Name="DeviceIcon"
                       Grid.Column="0"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="24"
                       VerticalAlignment="Center"
                       Margin="2,0,14,0"
                       Foreground="{DynamicResource OsdForegroundBrush}"
                       Text="&#xE767;"/>

            <!-- Nombre + barra -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="DeviceNameText"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource OsdForegroundBrush}"
                               Text="Altavoces"/>
                    <TextBlock x:Name="MutedBadge"
                               HorizontalAlignment="Right"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="12"
                               Foreground="{DynamicResource OsdSecondaryBrush}"
                               Visibility="Collapsed"
                               Text="Silenciado"/>
                </Grid>

                <!-- Barra de volumen (pista + relleno) -->
                <Grid x:Name="BarTrack" Height="4" Margin="0,9,0,1">
                    <Border Background="{DynamicResource OsdTrackBrush}" CornerRadius="2"/>
                    <Border x:Name="BarFill"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="2"
                            Width="0"/>
                </Grid>
            </StackPanel>

            <!-- Porcentaje -->
            <TextBlock x:Name="PercentText"
                       Grid.Column="2"
                       Margin="14,0,0,0"
                       MinWidth="30"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource OsdForegroundBrush}"
                       Text="0"/>
        </Grid>
    </Border>
</Window>
