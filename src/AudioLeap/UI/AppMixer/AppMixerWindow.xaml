<Window x:Class="AudioLeap.UI.AppMixer.AppMixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="RootBorder"
            Margin="24"
            MinWidth="360"
            MaxWidth="440"
            CornerRadius="14"
            Background="{DynamicResource OsdBackgroundBrush}"
            RenderTransformOrigin="0.5,0.5">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="SlideTransform"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                              Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="8,10">
            <TextBlock Margin="12,0,12,6"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12"
                       Foreground="{DynamicResource OsdSecondaryBrush}"
                       Text="{DynamicResource L_AppMixerTitle}"/>
            <StackPanel x:Name="SessionList"/>
        </StackPanel>
    </Border>
</Window>
