<Window x:Class="AudioLeap.UI.Mixer.MixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Fila de dispositivo: fondo suave al pasar el ratón -->
        <Style x:Key="DeviceRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background"
                                        Value="{DynamicResource OsdTrackBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider moderno: pista fina redondeada + thumb circular con anillo -->
        <Style x:Key="SliderFillButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="20">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="20">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource OsdTrackBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- Círculo exterior (anillo del color de la tarjeta) + punto interior acento.
                             El punto crece al pasar el ratón y se encoge al arrastrar, como en Win11. -->
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Ellipse Fill="{DynamicResource CardBrush}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="InnerDot" Fill="{DynamicResource AccentBrush}" Margin="4"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InnerDot" Property="Margin" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="InnerDot" Property="Margin" Value="5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFillButton}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackButton}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernSliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Margin="24"
            MinWidth="340"
            MaxWidth="420"
            CornerRadius="14"
            Background="{DynamicResource OsdBackgroundBrush}"
            RenderTransformOrigin="0.5,0.5">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="SlideTransform"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                              Opacity="0.35" Color="#000000"/>
        </Border.Effect>

        <StackPanel Margin="8,10">
            <TextBlock Margin="12,0,12,6"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12"
                       Foreground="{DynamicResource OsdSecondaryBrush}"
                       Text="{DynamicResource L_OutputDevices}"/>
            <StackPanel x:Name="DeviceList"/>
        </StackPanel>
    </Border>
</Window>
